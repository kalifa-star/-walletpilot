# Optional: required only for forward paper trading, not historical research.
# Copy to .env. Never put an API key in frontend code.
TWELVE_DATA_API_KEY=
PORT=3000

# Optional AI entry reviewer. Disabled by default; enabling makes paid API calls.
# Choose an available Responses API model supporting Structured Outputs.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REVIEW_ENABLED=false

# OPay Nigeria integration lab. mock makes no external payment requests.
# sandbox uses only testapi.opaycheckout.com. Live payments are unsupported.
OPAY_MODE=mock
OPAY_MERCHANT_ID=
OPAY_PRIVATE_KEY=
OPAY_PUBLIC_KEY=
# The auth documentation specifies the public key for payment-status requests.
# Confirm the contract for your staging merchant; explicit hmac is also supported.
OPAY_STATUS_AUTH=public
# Optional reachable HTTPS endpoint; manual status queries work without callbacks.
# OPAY_CALLBACK_URL=https://your-staging-domain.example/api/opay/callback
